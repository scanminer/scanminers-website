# Local development env template
# Copy to .env.local and fill values as needed.

# --- Cloudflare Turnstile ---
# Public key for client-side widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret for server verification
TURNSTILE_SECRET_KEY=
# (Alias if you prefer generic keys; both are read in code where applicable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Site URL ---
# Used for feeds, sitemaps, and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=contact@scanminers.com
RESEND_TO=founders@scanminers.com

# --- Optional analytics & errors ---
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=scanminers
SENTRY_PROJECT=javascript-nextjs

# --- Admin & automation tokens ---
ADMIN_ACTION_TOKEN=
WORKFLOW_DISPATCH_TOKEN=
CONTENT_BOT_TOKEN=

# --- Image / AI providers (optional) ---
STABILITY_API_KEY=
IMG_API_KEY=
PERPLEXITY_KEY=

# --- GitHub automation (optional) ---
GH_TOKEN=
GH_REPO=scanminer/scanminers-website

# --- Rate limits for content bots (example defaults) ---
WEEKLY_TOKENS=6000
MONTHLY_TOKENS=20000

# --- Feature flags (client-visible) ---
NEXT_PUBLIC_PERSONALIZATION=1
NEXT_PUBLIC_AB_TESTING=0
NEXT_PUBLIC_AI_IMAGES=1
NEXT_PUBLIC_EVENTS=1
