# --- Local development environment variables ---
# Copy this file to `.env.local` and fill in real values.
# Next.js will load `.env.local` automatically in dev.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics & instrumentation
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin basic auth (protects /admin)
ADMIN_USER=admin
ADMIN_PASS=change-me

# Perplexity AI (for /admin/drafts)
# Docs: https://docs.perplexity.ai/getting-started/models
# Recommended models (Nov 2025): sonar | sonar-pro | sonar-reasoning | sonar-reasoning-pro
PERPLEXITY_KEY=your-perplexity-api-key
PERPLEXITY_MODEL=sonar-pro

# GitHub automation (optional: one-click PR creation for drafts)
# Repo in owner/name form, e.g., scanminer/scanminers-website
GH_REPO=
# Optional alias (if you prefer different naming)
CONTENT_REPO=
# A token with repo scope (bot or PAT)
CONTENT_BOT_TOKEN=
# Your default branch name (usually main)
GIT_DEFAULT_BRANCH=main
# Optional alias
CONTENT_DEFAULT_BRANCH=
# Optional commit author identity for bot commits
CONTENT_AUTHOR_NAME=Scanminers Bot
CONTENT_AUTHOR_EMAIL=bot@scanminers.com

# Decap CMS login via GitHub OAuth (for /admin)
# Create a GitHub OAuth App and set the callback URL to:
#  - http://localhost:3000/api/decap-auth/auth (local dev)
#  - https://scanminers.com/api/decap-auth/auth (production)
#  - https://scanminers.pages.dev/api/decap-auth/auth (preview)
# Then paste the Client ID and Client Secret below for local testing.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Email (optional)
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Consultation billing (used in consultation confirmation emails)
CONSULT_BANK_ACCOUNT_NAME=
CONSULT_BANK_ACCOUNT=
CONSULT_BANK_IBAN=
CONSULT_BANK_BIC=
CONSULT_BANK_NOTE=

# Turnstile (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Rate limits for content bots (example defaults) ---
WEEKLY_TOKENS=6000
MONTHLY_TOKENS=20000

# --- Feature flags (client-visible) ---
NEXT_PUBLIC_PERSONALIZATION=1
NEXT_PUBLIC_AB_TESTING=0
NEXT_PUBLIC_AI_IMAGES=1
NEXT_PUBLIC_EVENTS=1
