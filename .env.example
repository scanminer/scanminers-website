# Example environment variables for Scanminers website
# Copy this file to `.env.local` for local development and fill in values.

# ----- Core site URLs -----
# Local default for absolute URLs. In production, set to your public domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Cloudflare Turnstile (CAPTCHA) -----
# Test keys work for local development; replace with real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAB_TEST_SITE_KEY
TURNSTILE_SECRET_KEY=0x4AAAAAAB_TEST_SECRET_KEY

# ----- Resend (email) -----
# Create a Resend API key and paste it below (format: re_*)
RESEND_API_KEY=
# Verified sender, e.g. contact@yourdomain.com
RESEND_FROM=
# Comma-separated recipients, e.g. founders@yourdomain.com
RESEND_TO=

# ----- Consultation billing (used in consultation confirmation emails) -----
CONSULT_BANK_ACCOUNT_NAME=
CONSULT_BANK_ACCOUNT=
CONSULT_BANK_IBAN=
CONSULT_BANK_BIC=
CONSULT_BANK_NOTE=

# ----- Cloudflare Web Analytics (optional) -----
# Safe to leave empty for local dev.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----- Sentry (optional) -----
# Public browser DSN (can be public); server DSN optional if you enable server reporting.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ----- Admin actions & image generation (optional) -----
# Must match the Pages env when used from CMS or preview.
ADMIN_ACTION_TOKEN=
# Provide one of the following for GitHub workflow dispatch (fine-grained PAT with repo/workflow scope),
# or set CONTENT_BOT_TOKEN instead. You only need one; CONTENT_BOT_TOKEN is preferred.
WORKFLOW_DISPATCH_TOKEN=
CONTENT_BOT_TOKEN=

# --- AI API Keys (optional for local) ---
PERPLEXITY_KEY=
PERPLEXITY_MODEL=sonar-pro
STABILITY_API_KEY=

# --- Rate limits for content bots (example defaults) ---
WEEKLY_TOKENS=6000
MONTHLY_TOKENS=20000

# ----- Admin basic auth (Phase 1 security) -----
ADMIN_USER=admin
ADMIN_PASS=

# --- GitHub automation ---
GH_REPO=scanminer/scanminers-website
GIT_DEFAULT_BRANCH=main

CONTENT_AUTHOR_NAME=ScanminersBot
CONTENT_AUTHOR_EMAIL=bot@scanminers.com

# Optional legacy tokens for local scripts (avoid when possible)
GH_TOKEN=

# Decap CMS login via GitHub OAuth (for /admin)
# Create a GitHub OAuth App and set callback URL to /api/decap-auth/auth.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
