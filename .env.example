# Example environment variables for Scanminers website
# Copy this file to `.env.local` for local development and fill in values.

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL (used for absolute links in sitemap/OG)
# Example (local): http://localhost:3000
# Example (prod): https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Resend Email
# Generate an API key in Resend dashboard and verify your sending domain.
RESEND_API_KEY=
# Strongly recommended: set a verified sender and one or more recipients.
# Example sender must be verified in Resend.
RESEND_FROM=contact@scanminers.com
# Comma-separated list of recipients.
RESEND_TO=founders@scanminers.com

# Optional: Cloudflare Web Analytics token
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Sentry (optional, for error tracking)
# Public DSN for browser (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=
# Secret DSN for server/edge
SENTRY_DSN=
SENTRY_ORG=scanminers
SENTRY_PROJECT=javascript-nextjs
# Optionally suppress global error handler file warning
# SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1
# Public site URL used for absolute links
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Cloudflare Turnstile keys
# Get these from Cloudflare Turnstile dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend
# RESEND_API_KEY=
# Optional: customize sender/recipient addresses
# RESEND_FROM=contact@yourverifieddomain.com
# RESEND_TO=you@example.com
