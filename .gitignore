# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# ignore nested node_modules from workers subproject(s)
/workers/**/node_modules

# next.js
/.next/
/out/

# contentlayer (generated)
/.contentlayer/

# production
/build

# cloudflare next-on-pages build output
.cf-nop*
.open-next/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow example, ignore real)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin
# Local audit output
project_audit.txt

# Python virtual environments
.venv/
venv/
env/
ENV/
*.pyc
__pycache__/
.wrangler
