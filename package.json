{
  "name": "scanminers-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "preinstall": "npm config set legacy-peer-deps true",
    "dev": "next dev",
    "build": "npm run contentlayer && next build && node scripts/generate-feeds.mjs && npx pagefind --site .next/server/app --output-subdir ../../public/pagefind",
    "preview": "opennextjs-cloudflare",
    "deploy": "opennextjs-cloudflare",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contentlayer": "node scripts/contentlayer-build.js",
    "build:content": "npm run contentlayer && node scripts/generate-feeds.mjs",
    "content:check": "node scripts/content-check.js",
    "test": "NODE_OPTIONS='--max_old_space_size=4096' vitest --run",
    "test:watch": "NODE_OPTIONS='--max_old_space_size=4096' vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "og:fetch": "node scripts/fetch-og-covers.mjs",
    "generate-mineral-textures": "tsx scripts/generate-mineral-textures.ts",
    "brain:etl": "tsx scripts/brain-etl.ts",
    "brain:etl:force": "tsx scripts/brain-etl.ts --force"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.2.2",
    "@octokit/rest": "^21.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sentry/browser": "10.19.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "contentlayer": "^0.3.4",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.552.0",
    "next": "15.5.4",
    "next-auth": "^4.24.13",
    "next-contentlayer": "^0.3.4",
    "next-themes": "^0.4.6",
    "plaiceholder": "^3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^4.3.0",
    "react-hook-form": "^7.66.0",
    "recharts": "^3.3.0",
    "resend": "^6.1.2",
    "rss": "^1.2.2",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^4.20251113.0",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.11.1",
    "@pagefind/default-ui": "^1.4.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "globby": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.6",
    "wrangler": "^4.46.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,md,mdx}": [
      "eslint --fix"
    ],
    "content/**/*.{mdx,md}": [
      "node scripts/content-check.js --staged || true"
    ]
  }
}
