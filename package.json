{
  "name": "scanminers-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "preinstall": "npm config set legacy-peer-deps true",
    "dev": "next dev",
    "build": "npm run contentlayer && next build && node scripts/generate-feeds.mjs && npx pagefind --site .next/server/app --output-subdir ../../public/pagefind",
    "cf:pack": "npx @cloudflare/next-on-pages -o .cf-nop -c",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contentlayer": "node scripts/contentlayer-build.js",
    "build:content": "npm run contentlayer && node scripts/generate-feeds.mjs",
    "content:check": "node scripts/content-check.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "generate:draft:gpt": "node scripts/generate-draft-with-gpt.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@sentry/browser": "10.19.0",
    "contentlayer": "^0.3.4",
    "next": "15.5.4",
    "next-contentlayer": "^0.3.4",
    "plaiceholder": "^3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^4.3.0",
    "resend": "^6.1.2",
    "rss": "^1.2.2",
    "sharp": "^0.34.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@pagefind/default-ui": "^1.4.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "globby": "^11.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "js-yaml": "^4.1.0",
    "openai": "^4.73.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.3.3",
    "simple-git": "^3.25.0",
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,md,mdx}": [
      "eslint --fix"
    ],
    "content/**/*.{mdx,md}": [
      "node scripts/content-check.js --staged || true"
    ]
  }
}
